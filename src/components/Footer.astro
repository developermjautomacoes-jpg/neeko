---
import { content } from '../config/content.js';
const { brand, footer } = content;
---

<footer class="footer">
  <div class="container footer-grid">

    <div class="footer-brand">
      <img src={brand.logoMain} alt="Neeko" class="footer-logo-img" id="footerLogoImg" width="149" height="48" loading="lazy" />
      <p>{footer.slogan}</p>
    </div>

    <div class="footer-links">
      <h4>Menu</h4>
      {footer.menu.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </div>

    <div class="footer-contact" id="contato">
      <h4>Contato</h4>
      <a href={`mailto:${brand.email}`}>
        <i data-lucide="mail" aria-hidden="true"></i>
        {brand.email}
      </a>
      <a href={brand.whatsapp} target="_blank" rel="noopener noreferrer">
        <i data-lucide="message-circle" aria-hidden="true"></i>
        WhatsApp
      </a>
      <a href={brand.instagram} target="_blank" rel="noopener noreferrer">
        <i data-lucide="instagram" aria-hidden="true"></i>
        @neeko.automacoes
      </a>

      <form id="budgetForm" class="budget-form">
        <div class="form-grid">
          <label>
            <span>Nome</span>
            <input type="text" name="nome" placeholder="Seu nome" autocomplete="name" required />
          </label>
          <label>
            <span>Telefone</span>
            <input type="tel" name="telefone" placeholder="(27) 99999-9999" autocomplete="tel" required />
          </label>
          <label>
            <span>E-mail</span>
            <input type="email" name="email" placeholder="seu@email.com" autocomplete="email" required />
          </label>
          <label>
            <span>Assunto</span>
            <input type="text" name="assunto" placeholder="Ex: Automação de rotina" autocomplete="off" required />
          </label>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Solicitar orçamento</button>
      </form>
    </div>

  </div>

  <div class="container footer-bottom">
    <p>{footer.copyright}</p>
  </div>
</footer>

<script>
  // Sync footer logo with current theme
  const updateFooterLogo = () => {
    const footerLogo = document.getElementById('footerLogoImg') as HTMLImageElement | null;
    if (!footerLogo) return;
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    footerLogo.src = isLight
      ? '/assets/logos/logo neeko fundo branco.png'
      : '/assets/logos/logo_neeko.png';
  };

  updateFooterLogo();

  const GOOGLE_SHEET_APP_URL = 'https://script.google.com/macros/s/AKfycbxn7wYrct9nvsf4WZ8b6hZvuZjNwUanoDCLXo3j4ZbM/dev';

  const budgetForm = document.getElementById('budgetForm');
  budgetForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const data = new FormData(form);
    const payload = {
      nome: (data.get('nome') || '').toString().trim(),
      telefone: (data.get('telefone') || '').toString().trim(),
      email: (data.get('email') || '').toString().trim(),
      assunto: (data.get('assunto') || '').toString().trim(),
    };

    const hasRequiredFields = payload.nome && payload.telefone && payload.email && payload.assunto;
    if (!hasRequiredFields) {
      return;
    }

    try {
      const response = await fetch(GOOGLE_SHEET_APP_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const responseText = await response.text();
      let responseBody: any = {};
      if (responseText) {
        try {
          responseBody = JSON.parse(responseText);
        } catch {
          responseBody = { message: responseText };
        }
      }

      if (!response.ok || responseBody.ok === false) {
        throw new Error(responseBody.message || 'Falha ao enviar para o Google Sheets');
      }

      alert('Seu orçamento foi enviado com sucesso!');
      form.reset();
      return;
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Erro desconhecido';
      console.error('Erro ao enviar formulário:', message);
      alert(`Não foi possível enviar para a planilha: ${message}`);
    }
  });

  // Observe theme changes
  const observer = new MutationObserver(updateFooterLogo);
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>
