---
import { content } from '../config/content.js';
const { hero, services } = content;

const heroServiceLinks = services.items.map((service) => {
  const id = service.title
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

  return { ...service, id };
});
---

<section class="hero">
  <div class="container hero-container">

    <div class="hero-content fade-up">
      <h1>
        {hero.title} <span class="text-gradient">{hero.titleHighlight}</span> {hero.titleEnd}
      </h1>
      <p>{hero.subtitle}</p>
      <div class="hero-buttons">
        <a href={hero.cta1.href} class="btn btn-primary">{hero.cta1.label}</a>
        <a href={hero.cta2.href} class="btn btn-secondary">{hero.cta2.label}</a>
      </div>
    </div>

    <div class="hero-visual fade-up delay-1">
      <div class="hero-video-shell" aria-label="Animação de automação, IA e tecnologia">
        <video
          class="hero-video"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-label="Animação de automação, IA e tecnologia"
        >
          <source src="/assets/videos/servicos.mp4" type="video/mp4" />
        </video>
      </div>
    </div>

  </div>
</section>

